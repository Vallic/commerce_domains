{#
/**
 * @file
 * An email to the buyer about the handover of their domain.
 *
 * Laid out like Commerce's order receipt, in the store's name.
 *
 * Available variables:
 * - order_entity: The order.
 * - handover: The handover.
 * - step: What the email is about: started, auth_code, pushed or transferred.
 * - heading: The heading.
 * - intro: Paragraphs before the steps.
 * - steps: What happens next, in order; in the started email.
 * - auth_code: The transfer auth code; in the auth_code email only. Print it
 *   once, here, and nowhere else.
 * - outro: Paragraphs at the end.
 *
 * @ingroup themeable
 */
#}
<table style="margin: 15px auto 0 auto; max-width: 768px; font-family: arial,sans-serif">
  <tbody>
  <tr>
    <td>
      <table style="margin-left: auto; margin-right: auto; max-width: 768px; text-align: center;">
        <tbody>
        <tr>
          <td>
            <a href="{{ url('<front>') }}" style="color: #0e69be; text-decoration: none; font-weight: bold; margin-top: 15px;">{{ order_entity.getStore.label }}</a>
          </td>
        </tr>
        </tbody>
      </table>
      <table style="min-width: 450px; margin: 5px auto 0 auto; border: 1px solid #ccc; border-radius: 5px; padding: 40px 30px 30px 30px;">
        <tbody>
        <tr>
          <td style="font-size: 24px; padding-bottom: 25px; text-align: center;">{{ heading }}</td>
        </tr>
        {% for paragraph in intro %}
          <tr>
            <td style="padding-bottom: 10px;">{{ paragraph }}</td>
          </tr>
        {% endfor %}
        {% if steps %}
          <tr>
            <td style="padding-bottom: 10px;">
              <ol style="margin: 0; padding-left: 20px;">
                {% for item in steps %}
                  <li style="padding-bottom: 5px;">{{ item }}</li>
                {% endfor %}
              </ol>
            </td>
          </tr>
        {% endif %}
        {% if auth_code %}
          <tr>
            <td style="padding: 15px; font-family: monospace; font-size: 20px; text-align: center; word-break: break-all; background-color: #f5f5f5; border-radius: 5px;">{{ auth_code }}</td>
          </tr>
        {% endif %}
        {% for paragraph in outro %}
          <tr>
            <td style="padding-top: 10px;">{{ paragraph }}</td>
          </tr>
        {% endfor %}
        <tr>
          <td style="padding-top: 25px; font-size: 13px; color: #555; text-align: center;">
            {{ 'Order @number'|t({'@number': order_entity.getOrderNumber ?: order_entity.id}) }}
          </td>
        </tr>
        </tbody>
      </table>
    </td>
  </tr>
  </tbody>
</table>
