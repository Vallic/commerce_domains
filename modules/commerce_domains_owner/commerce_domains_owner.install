<?php

/**
 * @file
 * Install, uninstall and update hooks for Commerce Domains Owner.
 */

declare(strict_types=1);

use Drupal\commerce_domains\Catalog;
use Drupal\commerce_domains_owner\Appraiser;
use Drupal\commerce_domains_owner\Checklist;
use Drupal\commerce_domains_owner\Notifier;
use Drupal\commerce_domains_owner\Plugin\Commerce\EntityTrait\DomainCosts;
use Drupal\commerce_domains_owner\Renewals;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_install().
 *
 * Turns on the costs trait for the product types that sell domains, and
 * takes the registrar checks so far as seen: only domains that go missing
 * from now on are news.
 */
function commerce_domains_owner_install(bool $is_syncing): void {
  // A config import brings the fields and the product types along.
  if (!$is_syncing) {
    $trait_manager = \Drupal::service('plugin.manager.commerce_entity_trait');
    $field_manager = \Drupal::service('commerce.configurable_field_manager');
    $trait = $trait_manager->createInstance(DomainCosts::ID);
    $storage = \Drupal::entityTypeManager()->getStorage('commerce_product_type');
    /** @var \Drupal\commerce_product\Entity\ProductTypeInterface $type */
    foreach ($storage->loadMultiple(\Drupal::service(Catalog::class)->productTypes()) as $type) {
      foreach ($trait->buildFieldDefinitions() as $field_name => $definition) {
        // Kept from an earlier install.
        if (FieldConfig::loadByName('commerce_product', $type->id(), $field_name)) {
          continue;
        }
        $definition->setTargetEntityTypeId('commerce_product');
        $definition->setTargetBundle($type->id());
        $definition->setName($field_name);
        $field_manager->createField($definition);
      }
      $type->setTraits(array_values(array_unique([...$type->getTraits(), DomainCosts::ID])))->save();
    }
  }
  \Drupal::service(Notifier::class)->seeRegistrarChecks();
}

/**
 * Implements hook_uninstall().
 *
 * Takes the costs trait off the product types, so their forms keep working
 * without its plugin. The fields and what was entered in them stay.
 */
function commerce_domains_owner_uninstall(bool $is_syncing): void {
  if (!$is_syncing) {
    /** @var \Drupal\commerce_product\Entity\ProductTypeInterface $type */
    foreach (\Drupal::entityTypeManager()->getStorage('commerce_product_type')->loadMultiple() as $type) {
      if (in_array(DomainCosts::ID, $type->getTraits(), TRUE)) {
        $type->setTraits(array_values(array_diff($type->getTraits(), [DomainCosts::ID])))->save();
      }
    }
  }
  \Drupal::state()->deleteMultiple([
    Checklist::LANDER_KEY,
    Notifier::DIGEST_KEY,
    Notifier::REGISTRAR_CHECKS_KEY,
    Notifier::SYNC_FAILURES_KEY,
    Renewals::OFF_SALE_KEY,
    Appraiser::COUNT_KEY,
  ]);
}

/**
 * Adds "Lease to own" to the sale of the domain product types.
 */
function commerce_domains_owner_update_11001(): void {
  $trait = \Drupal::service('plugin.manager.commerce_entity_trait')->createInstance(DomainCosts::ID);
  $definition = $trait->buildFieldDefinitions()['domain_lease_months'];
  $field_manager = \Drupal::service('commerce.configurable_field_manager');
  /** @var \Drupal\commerce_product\Entity\ProductTypeInterface $type */
  foreach (\Drupal::entityTypeManager()->getStorage('commerce_product_type')->loadMultiple() as $type) {
    if (!in_array(DomainCosts::ID, $type->getTraits(), TRUE) || FieldConfig::loadByName('commerce_product', $type->id(), 'domain_lease_months')) {
      continue;
    }
    $field = clone $definition;
    $field->setTargetEntityTypeId('commerce_product');
    $field->setTargetBundle($type->id());
    $field->setName('domain_lease_months');
    $field_manager->createField($field);
  }
}

/**
 * Adds the appraisal fields to the domain product types.
 */
function commerce_domains_owner_update_11002(): void {
  $trait = \Drupal::service('plugin.manager.commerce_entity_trait')->createInstance(DomainCosts::ID);
  $definitions = array_intersect_key($trait->buildFieldDefinitions(), array_flip(DomainCosts::APPRAISAL_FIELDS));
  $field_manager = \Drupal::service('commerce.configurable_field_manager');
  /** @var \Drupal\commerce_product\Entity\ProductTypeInterface $type */
  foreach (\Drupal::entityTypeManager()->getStorage('commerce_product_type')->loadMultiple() as $type) {
    if (!in_array(DomainCosts::ID, $type->getTraits(), TRUE)) {
      continue;
    }
    foreach ($definitions as $name => $definition) {
      if (FieldConfig::loadByName('commerce_product', $type->id(), $name)) {
        continue;
      }
      $field = clone $definition;
      $field->setTargetEntityTypeId('commerce_product');
      $field->setTargetBundle($type->id());
      $field->setName($name);
      $field_manager->createField($field);
    }
  }
  $config = \Drupal::configFactory()->getEditable('commerce_domains_owner.settings');
  if ($config->get('appraisals_per_day') === NULL) {
    $config->set('appraisals_per_day', 50)->save();
  }
}

/**
 * Clears sales recorded without what the domain sold for.
 *
 * A sale needs its price: the ones without, e.g. stamped by a date widget
 * that saved a blank date as the time of saving, are no sales. The domains
 * stay off sale; the update lists them, to put back on sale where wrong.
 */
function commerce_domains_owner_update_11003(): string {
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('commerce_product');
  if (!isset($definitions['domain_sold'], $definitions['domain_sale_price'])) {
    return 'No sale fields.';
  }
  $storage = \Drupal::entityTypeManager()->getStorage('commerce_product');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->exists('domain_sold')
    ->notExists('domain_sale_price.number')
    ->execute();
  $names = [];
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  foreach ($storage->loadMultiple($ids) as $product) {
    foreach (['domain_sold', 'domain_sold_via', 'domain_lease_months'] as $field) {
      if ($product->hasField($field)) {
        $product->set($field, NULL);
      }
    }
    // Not an edit: the product keeps its changed time.
    $product->setSyncing(TRUE)->save();
    $names[] = $product->hasField('domain') ? (string) $product->get('domain')->value : $product->label();
  }
  return $names
    ? sprintf('Cleared %d sales without a price; still off sale: %s.', count($names), implode(', ', $names))
    : 'No sales without a price.';
}
