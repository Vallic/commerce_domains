<?php

/**
 * @file
 * Install and update hooks for Commerce Domains Marketplace.
 */

declare(strict_types=1);

use Drupal\advancedqueue\Entity\Queue;
use Drupal\advancedqueue\Job;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Config\InstallStorage;
use Drupal\commerce_domains_marketplace\ListingRecorder;
use Drupal\commerce_domains_marketplace\SyncScheduler;

/**
 * Implements hook_schema().
 */
function commerce_domains_marketplace_schema(): array {
  return [ListingRecorder::TABLE => ListingRecorder::schema()];
}

/**
 * Adds the table that records each domain's listing on each marketplace.
 */
function commerce_domains_marketplace_update_11001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists(ListingRecorder::TABLE)) {
    $schema->createTable(ListingRecorder::TABLE, ListingRecorder::schema());
  }
}

/**
 * Adds the domain overview and the marketplace listings report.
 */
function commerce_domains_marketplace_update_11002(): void {
  $path = \Drupal::service('extension.list.module')->getPath('commerce_domains_marketplace');
  // Installs each view whose dependencies the site has, e.g. Views itself.
  \Drupal::service('config.installer')->installOptionalConfig(new FileStorage($path . '/' . InstallStorage::CONFIG_OPTIONAL_DIRECTORY));
}

/**
 * Moves automatic pushes to Advanced Queue.
 */
function commerce_domains_marketplace_update_11003(): void {
  \Drupal::service('module_installer')->install(['advancedqueue']);
  $path = \Drupal::service('extension.list.module')->getPath('commerce_domains_marketplace');
  $config = (new FileStorage($path . '/' . InstallStorage::CONFIG_INSTALL_DIRECTORY))->read('advancedqueue.advancedqueue_queue.' . SyncScheduler::QUEUE);
  if (!$queue = Queue::load(SyncScheduler::QUEUE)) {
    $queue = Queue::create($config);
    $queue->save();
  }

  // Carry over pushes still waiting in the core queue.
  $old = \Drupal::queue('commerce_domains_marketplace_sync');
  $jobs = [];
  while (is_object($item = $old->claimItem())) {
    $jobs[] = Job::create(SyncScheduler::JOB_TYPE, $item->data);
    $old->deleteItem($item);
  }
  if ($jobs) {
    $queue->enqueueJobs($jobs);
  }
  $old->deleteQueue();
}

/**
 * Records when a marketplace sale was found, on each domain's listing.
 */
function commerce_domains_marketplace_update_11004(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists(ListingRecorder::TABLE, 'sold')) {
    $schema->addField(ListingRecorder::TABLE, 'sold', ListingRecorder::schema()['fields']['sold']);
  }
}

/**
 * Records the views, leads and offers of each domain's listings.
 */
function commerce_domains_marketplace_update_11005(): void {
  $schema = \Drupal::database()->schema();
  foreach (ListingRecorder::statsSchema() as $field => $spec) {
    if (!$schema->fieldExists(ListingRecorder::TABLE, $field)) {
      $schema->addField(ListingRecorder::TABLE, $field, $spec);
    }
  }
}
